\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Which prose to train on.} Same base model, same prompt, no head; the $1{,}191$ groups with an odd member judged in both arms, paired, greedy. Coverage, contradictions and all-correct differ at $p<10^{-45}$; \emph  {outlier found} at $p=9\times 10^{-6}$.}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:corpus}{{7}{7}{\textbf {Which prose to train on.} Same base model, same prompt, no head; the $1{,}191$ groups with an odd member judged in both arms, paired, greedy. Coverage, contradictions and all-correct differ at $p<10^{-45}$; \emph {outlier found} at $p=9\times 10^{-6}$}{table.caption.12}{}}
\newlabel{tab:corpus@cref}{{[table][7][]7}{[1][7][]7}{}{}{}}
