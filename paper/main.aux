\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Base model: Llama-3.1-8B vs.\ AstroSage-8B}, identical corpus, recipe and seed; rule-scored, greedy; the better model in bold. Metrics: \emph  {numeric acc.} = fraction of numbers the text states that fall within tolerance of the catalog value; \emph  {qualitative acc.} (single) = fraction of class words (dwarf/giant, spiral/elliptical, \ldots  ) that match the catalog; \emph  {relational acc.} (pair) = fraction of comparisons (``hotter than'', ``more massive'') that match; \emph  {outlier found} = fraction of groups --- among those that contain an odd member --- in which the text names the true outlier \emph  {and} its property. $^\dagger $~Population rows come from an earlier 150-group subsample and are comparable only to each other, not to the full-fold population results. }}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:basemodel}{{1}{4}{\textbf {Base model: Llama-3.1-8B vs.\ AstroSage-8B}, identical corpus, recipe and seed; rule-scored, greedy; the better model in bold. Metrics: \emph {numeric acc.} = fraction of numbers the text states that fall within tolerance of the catalog value; \emph {qualitative acc.} (single) = fraction of class words (dwarf/giant, spiral/elliptical, \ldots ) that match the catalog; \emph {relational acc.} (pair) = fraction of comparisons (``hotter than'', ``more massive'') that match; \emph {outlier found} = fraction of groups --- among those that contain an odd member --- in which the text names the true outlier \emph {and} its property. $^\dagger $~Population rows come from an earlier 150-group subsample and are comparable only to each other, not to the full-fold population results}{table.caption.6}{}}
\newlabel{tab:basemodel@cref}{{[table][1][]1}{[1][4][]4}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The head fixes the relational task --- on both tracks, under both scorers.} Each row is one arm pair on one task, measured two ways. Stars: does the text name the true odd member \emph  {and} its property, over the $1{,}203$ test groups that contain one. Galaxies: does the text call the shape-vs-history relation correctly, over the $1{,}484$ galaxies where the two genuinely \emph  {disagree}. The rule verifier and the LLM judge are independent instruments; they agree on the size and direction of the stellar effect. The galaxy rows are scored differently, and $^{\ast }$ explains why; their two rows are two controls (a narrator trained without the token, and the same trained narrator with its token removed at test time), not two scorers. Numbers are comparable \emph  {within} a row block only --- the two tracks are different tasks on different scales.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:headboth}{{2}{4}{\textbf {The head fixes the relational task --- on both tracks, under both scorers.} Each row is one arm pair on one task, measured two ways. Stars: does the text name the true odd member \emph {and} its property, over the $1{,}203$ test groups that contain one. Galaxies: does the text call the shape-vs-history relation correctly, over the $1{,}484$ galaxies where the two genuinely \emph {disagree}. The rule verifier and the LLM judge are independent instruments; they agree on the size and direction of the stellar effect. The galaxy rows are scored differently, and $^{\ast }$ explains why; their two rows are two controls (a narrator trained without the token, and the same trained narrator with its token removed at test time), not two scorers. Numbers are comparable \emph {within} a row block only --- the two tracks are different tasks on different scales}{table.caption.7}{}}
\newlabel{tab:headboth@cref}{{[table][2][]2}{[1][4][]4}{}{}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}is it the token, or the retraining that came with it?}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Breaking the token at test time}, stellar group task, full test fold ($n{=}1{,}203$ groups with an odd member, greedy, judge-scored). \emph  {found} $=$ the text names the true odd member and its property. The middle two rows are the \emph  {same} trained model as the last one, with its token damaged at generation time --- same weights, same training regime, only the token changes. $p$ is exact McNemar against the intact arm.}}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:ablate}{{3}{5}{\textbf {Breaking the token at test time}, stellar group task, full test fold ($n{=}1{,}203$ groups with an odd member, greedy, judge-scored). \emph {found} $=$ the text names the true odd member and its property. The middle two rows are the \emph {same} trained model as the last one, with its token damaged at generation time --- same weights, same training regime, only the token changes. $p$ is exact McNemar against the intact arm}{table.caption.8}{}}
\newlabel{tab:ablate@cref}{{[table][3][]3}{[1][5][]5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}is it reasoning, or is it recall?}{5}{subsection.4.4}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {The adversarial set}, $1{,}000$ stellar groups whose odd member was never an odd member in training, greedy, judge-scored. \emph  {found} $=$ the text names the true odd member and its property. $p$ is exact McNemar (Wilcoxon for contradictions).}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:adversarial}{{4}{6}{\textbf {The adversarial set}, $1{,}000$ stellar groups whose odd member was never an odd member in training, greedy, judge-scored. \emph {found} $=$ the text names the true odd member and its property. $p$ is exact McNemar (Wilcoxon for contradictions)}{table.caption.9}{}}
\newlabel{tab:adversarial@cref}{{[table][4][]4}{[1][5][]6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}giving the model the numbers as text does not help}{6}{subsection.4.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {The catalog-text control}, the $n{=}884$ groups with an odd member judged in all four arms, greedy. \textbf  {found} $=$ outlier \emph  {and} property, the paper's consistent metric. \emph  {outlier named} is the index alone and \emph  {lift} divides it by the fraction of the group the arm names ($1.0$ = chance given that much hedging): the two together show \emph  {why} the index alone misleads. Under \textbf  {found} the text arm's apparent lead is gone --- $0.331$ against $0.320$ for latent tokens, both less than half the head's $0.652$. \emph  {stars named} and \emph  {finished} describe all $1{,}500$ generations, not the judged subset.}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:text}{{5}{6}{\textbf {The catalog-text control}, the $n{=}884$ groups with an odd member judged in all four arms, greedy. \textbf {found} $=$ outlier \emph {and} property, the paper's consistent metric. \emph {outlier named} is the index alone and \emph {lift} divides it by the fraction of the group the arm names ($1.0$ = chance given that much hedging): the two together show \emph {why} the index alone misleads. Under \textbf {found} the text arm's apparent lead is gone --- $0.331$ against $0.320$ for latent tokens, both less than half the head's $0.652$. \emph {stars named} and \emph {finished} describe all $1{,}500$ generations, not the judged subset}{table.caption.10}{}}
\newlabel{tab:text@cref}{{[table][5][]5}{[1][6][]6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}the head has to match the question}{6}{subsection.4.6}\protected@file@percent }
