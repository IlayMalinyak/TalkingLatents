\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {The wrong head on galaxies.} AUC for ranking the odd member of a group ($400$ populations, test fold), for a density head reading the full aligned features vs.\ the same head given only catalog labels. Negative gain means the features make it worse.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:wronghead}{{6}{7}{\textbf {The wrong head on galaxies.} AUC for ranking the odd member of a group ($400$ populations, test fold), for a density head reading the full aligned features vs.\ the same head given only catalog labels. Negative gain means the features make it worse}{table.caption.11}{}}
\newlabel{tab:wronghead@cref}{{[table][6][]6}{[1][6][]7}{}{}{}}
